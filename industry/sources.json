        "mode": "json_api",
        "itemsPath": "jData.data.items",
        "titlePaths": ["sTitle"],
        "urlTemplate": "{raw:sRedirectURL}",
        "summaryPaths": ["sDesc"],
        "publishedAtPath": "sIdxTime",
        "publishedAtUtcOffset": "+08:00",
        "externalIdPath": "iDocID",
        "bodyUrlTemplate": "https://comm.ams.game.qq.com/ide/?iChartId=329870&iSubChartId=329870&sIdeToken=vDQriw&id={raw:iDocID}",
        "bodyPath": "jData.data.0.sContent",
        "publisherUrlPrefixes": ["https://df.qq.com/cp/a20240906main/"],
        "_aihot": { "initialBackfillLimit": 12 }
      },
      "tier": "T1",
      "owner_entity_id": "delta-force",
      "participation_mode": "editorial",
      "interval_minutes": 60,
      "tags": ["官方", "公告"],
